#!/usr/bin/env bash
# ============================================================================
# aap.eda.dynatrace.push — dev-environment template
# ============================================================================
# Copy to docs/dev-environment.sh (gitignored) and fill in real values.
# Source before running aap_config/load.yml or dtctl commands:
#
#   cp docs/dev-environment.sh.example docs/dev-environment.sh
#   # edit docs/dev-environment.sh
#   source docs/dev-environment.sh
#
# NEVER commit docs/dev-environment.sh — CI fails if it's tracked.
# ============================================================================

# --- AAP connection ---
export AAP_HOSTNAME="https://controller-<id>.apps.<cluster>.rhdp.net"
export AAP_CONTROLLER_USERNAME="admin"
export AAP_CONTROLLER_PASSWORD="REPLACE_ME"
export AAP_VALIDATE_CERTS="false"

# --- Organization ---
# Override if your AAP org differs from the default.
# export DT_EDA_PUSH_ORG="IT Service Automation"

# --- Event Stream shared secret ---
# The Bearer token that Dynatrace sends and the AAP Event Stream validates.
# Generate a strong random value and paste it in BOTH this file AND the
# Dynatrace EDA connection (dynatrace/eda-connection.yaml uses a placeholder).
export EDA_EVENT_STREAM_TOKEN="REPLACE_ME_EVENT_STREAM_TOKEN"

# --- Dynatrace ---
# API host (for optional write-back). The push model doesn't poll, but the host
# is needed if you want to comment on / close problems from AAP.
export DT_API_HOST="https://<env-id>.live.dynatrace.com"

# --- dtctl auth (OAuth) ---
# Create an OAuth client in Dynatrace (Settings > OAuth clients) with scopes:
#   automation:workflows:read, automation:workflows:write,
#   settings:objects:read, settings:objects:write
export DT_OAUTH_CLIENT_ID="REPLACE_ME"
export DT_OAUTH_CLIENT_SECRET="REPLACE_ME"
export DT_OAUTH_SSO_ENDPOINT="https://sso.dynatrace.com/sso/oauth2/token"
export DT_ENV_URL="https://<env-id>.apps.dynatrace.com"

# --- Rulebook condition ---
# Regex pattern for matching incoming push events. Tune after capturing the
# real event payload shape in Phase 3.
# export DT_MATCH_PATTERN=".*"
